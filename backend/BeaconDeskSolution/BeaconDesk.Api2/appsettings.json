{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "BeaconDesk-AzureDatabase": "Server=tcp:databaseappsmj.database.windows.net,1433;Initial Catalog=BeaconDesk-DataBase;Persist Security Info=False;User ID=adminServer;Password=0914190137MJjb@;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning", // Oculta ruido de .NET
        "System": "Warning" // Oculta ruido de Sistema
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.json", // <--- Aquí define la carpeta y extensión
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" // <--- ESTO CUMPLE TU RNF DE JSON
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
